# Environment Variables & LLM API Credentials
# Copy this file to .env and insert your real API keys.
# .env is ignored by git and will never be committed.

# Google Gemini API Key (Recommended for fast, low-cost explanations)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Local Ollama / vLLM endpoint (Optional - for local GPU/CPU models)
# OLLAMA_ENDPOINT=http://localhost:11434/v1/chat/completions
