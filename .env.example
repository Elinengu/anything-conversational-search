# Environment Variables & LLM API Credentials
# Copy this file to .env and insert your real API keys.
# .env is ignored by git and will never be committed.

# DeepSeek API Key (the only supported real LLM backend - src/llm.py)
# Get a key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: override the default model (deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat
